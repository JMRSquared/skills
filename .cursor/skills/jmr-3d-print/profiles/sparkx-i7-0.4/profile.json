{
  "printer": "Creality SPARKX i7 with CFS-lite (4 slots), 0.4 mm nozzle, PLA",
  "bed": {
    "width": 260,
    "depth": 260
  },
  "maxHeight": 255,
  "slots": 4,
  "postprocess": ["strip-start-toolchange", "multicolour-header", "slot-colours"],
  "start": "screen",
  "prepareMacro": "PRINT_PREPARE_LOAD_MATERIAL",
  "source": {
    "slicer": "Creality Print 7.3.2 flatpak, profiles/Creality",
    "machine": "SPARKX i7 0.4 nozzle",
    "process": "0.20mm Standard @SPARKX i7 0.4 nozzle",
    "filament": "CR-PLA @SPARKX i7 0.4 nozzle",
    "qualities": "processes/*.json from the matching @SPARKX i7 0.4 nozzle process profiles"
  }
}
